# Required for live OHLCV from Polygon.io
# Get a key at https://polygon.io/dashboard/keys
POLYGON_API_KEY=
MARKET_DATA_PROVIDER=polygon

# Keep false to force real Polygon data.
# Only set true if you need synthetic bars without an API key.
DEMO_MODE=false

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-me

# Set true on HTTPS production so the login cookie is marked Secure.
COOKIE_SECURE=false

# Databento — option chain for Tabla de Contratos (server-only).
# Never prefix with NEXT_PUBLIC_ and never send this token to the browser.
DATABENTO_API_KEY=
